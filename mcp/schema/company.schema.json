{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Premiumware Company Profile",
  "type": "object",
  "required": ["name", "registrationNumber", "jurisdictions", "locations", "contacts", "services"],
  "properties": {
    "name": { "type": "string" },
    "brandTagline": { "type": "string" },
    "registrationNumber": { "type": "string" },
    "jurisdictions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "city", "country"],
        "properties": {
          "label": { "type": "string" },
          "address": { "type": "string" },
          "city": { "type": "string" },
          "country": { "type": "string" }
        }
      },
      "minItems": 1
    },
    "website": { "type": "string", "format": "uri" },
    "contacts": {
      "type": "array",
      "items": { "$ref": "./contact.schema.json" },
      "minItems": 1
    },
    "services": {
      "type": "array",
      "items": { "$ref": "./service.schema.json" },
      "minItems": 1
    },
    "projects": {
      "type": "array",
      "items": { "$ref": "./project.schema.json" }
    },
    "team": {
      "type": "array",
      "items": { "$ref": "./team.schema.json" }
    },
    "offers": {
      "type": "array",
      "items": { "$ref": "./offer.schema.json" }
    },
    "updatedAt": { "type": "string", "format": "date-time" },
    "version": { "type": "string" }
  }
}
