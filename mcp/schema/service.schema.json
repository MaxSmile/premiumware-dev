{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Service",
  "type": "object",
  "required": ["id", "name", "summary", "outcomes"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "summary": { "type": "string" },
    "outcomes": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "deliveryModels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "techStack": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pricingModel": { "type": "string" },
    "cta": { "type": "string" }
  }
}
