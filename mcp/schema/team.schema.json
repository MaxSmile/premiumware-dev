{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Team Member",
  "type": "object",
  "required": ["id", "name", "role"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "role": { "type": "string" },
    "timezone": { "type": "string" },
    "skills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "experience": { "type": "string" }
  }
}
